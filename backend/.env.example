PORT=8000
DATABASE_URL="postgresql://gyannportal_user:your_strong_password@localhost:5432/gyannportal_db?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-secret-string"
JWT_EXPIRES_IN="1d"

# Refresh tokens (opaque, stored hashed in DB)
JWT_REFRESH_SECRET="change-me-to-another-long-random-secret-string"
JWT_REFRESH_EXPIRES_IN="30d"

# CORS (comma-separated list of allowed origins; defaults to local dev origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:5173"

# Seed admin password (used by `npx prisma db seed`)
SEED_ADMIN_PASSWORD="SuperAdmin@123"